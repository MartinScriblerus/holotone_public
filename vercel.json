{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/embed", "destination": "/embed.html" },
    { "source": "/embed/:path*", "destination": "/embed.html" },
    { "source": "/projection", "destination": "/projection.html" },
    { "source": "/projection/:target", "destination": "/projection.html" },
    { "source": "/hydra/:target", "destination": "/projection.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.vercel.app http://localhost:* http://127.0.0.1:*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
